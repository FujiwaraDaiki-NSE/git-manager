# 走査するホスト側のディレクトリ。ここが表示パスの基準にもなる
GITDASH_SCAN_ROOT=/home/you

# コンテナを動かす uid/gid。`id -u` / `id -g` の値を入れる
GITDASH_UID=1000
GITDASH_GID=1000

# Required for the host-local agent REST/MCP integration.
GITDASH_AGENT_PORT=8000
GITDASH_AGENT_TOKEN=replace-with-a-random-secret
# Host-side hook destination; keep the port aligned with GITDASH_AGENT_PORT.
GITDASH_AGENT_ENDPOINT=http://127.0.0.1:8000/api/agent-events

# 任意
GITDASH_MAX_DEPTH=8
GITDASH_WORKERS=16
GITDASH_FETCH=true
GITDASH_FETCH_WORKERS=4
GITDASH_FETCH_INTERVAL_SEC=300
GITDASH_WATCH=true
